
# ── Worldpay Access Checkout (card-on-page / checkout flow) ─────────────────
# Public client key — safe to expose in frontend.
# Obtain from: Worldpay Merchant Portal → Credentials → Access Checkout → Client Key
VITE_WORLDPAY_CLIENT_KEY=

# ── Worldpay Hosted Payment Page (HPP / invoice payment links) ───────────────
# Merchant Code — shown in Worldpay Merchant Portal → Profile → Merchant Code
VITE_WORLDPAY_MERCHANT_CODE=

# Installation ID — shown in Worldpay Merchant Portal → Installations → ID
# (create a new Installation if one does not exist)
VITE_WORLDPAY_INSTALLATION_ID=

# Secret Word — set in Worldpay Merchant Portal → Installations → Payment Response Password
# IMPORTANT: NEVER expose this in client code. Keep it server-side only.
# Used only if you add a server-side MAC signature step in the future.
VITE_WORLDPAY_SECRET_WORD=

