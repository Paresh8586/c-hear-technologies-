# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application identifier
VITE_APP_ID=

# Worldpay Hosted Payments
# Keep disabled until Worldpay supplies the merchant configuration.
VITE_WORLDPAY_ENABLED=false
VITE_WORLDPAY_ENVIRONMENT=test
VITE_WORLDPAY_CHECKOUT_ENDPOINT=/api/worldpay/create-payment-session

# Server-only Vercel Function variables. Never use the VITE_ prefix here.
WORLDPAY_HPP_ENDPOINT=
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_INSTALLATION_ID=
WORLDPAY_WEBHOOK_SECRET=
